<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2026.10.17</Version>
    <AssemblyName>AutoCommand</AssemblyName>
    <Product>AutoCommand</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <!-- Suppress duplicate-attribute CS0579 from the WPF XAML designer _wpftmp project -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="System.Management" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0-preview.4.25258.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Sdk\AutoCommand.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Web\telemetry.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\telemetry_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude scratch/test scripts — they define their own Main() -->
    <Compile Remove="ScratchTest\**" />
    <Compile Remove="Sdk\**" />
  </ItemGroup>

  <!-- Filter out Linux .so native binaries when publishing for Windows win-x64 -->
  <Target Name="RemoveUnusedPlatformLibs" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.so'" />
    </ItemGroup>
  </Target>

  <!-- ── Versioning: <Version> above is the single source of truth ──
       GenerateAssemblyInfo stays false (WPF designer CS0579 workaround), so this
       target generates the assembly version attributes from <Version> into obj\
       at build time. Properties\AssemblyInfo.cs deliberately carries none — never
       hand-add AssemblyVersion/FileVersion/InformationalVersion anywhere; bump
       <Version> and everything (binary, tag, zips, release title via release.ps1)
       follows. -->
  <Target Name="GenerateVersionAssemblyInfo" BeforeTargets="BeforeCompile">
    <Error Condition="'$(Version)' == ''"
           Text="GenerateVersionAssemblyInfo: &lt;Version&gt; is empty — it is the single source of truth and must be set (e.g. 2026.10.15)." />
    <PropertyGroup>
      <Version4>$([System.Version]::Parse('$(Version)').ToString()).0</Version4>
      <GeneratedVersionFile>$(IntermediateOutputPath)GeneratedVersionInfo.cs</GeneratedVersionFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <ItemGroup>
      <GeneratedVersionLines Include="// Auto-generated from &lt;Version&gt; in AutoCommand.csproj — do not edit." />
      <GeneratedVersionLines Include="using System.Reflection%3B" />
      <GeneratedVersionLines Include="[assembly: AssemblyVersion(&quot;$(Version4)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyFileVersion(&quot;$(Version4)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyInformationalVersion(&quot;$(Version)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedVersionFile)" Lines="@(GeneratedVersionLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(GeneratedVersionFile)" />
    </ItemGroup>
  </Target>

  <!-- Ship the Svchost Trace capture engine inside the app: published as a
       self-contained single exe into tools\ next to AutoCommand.exe.
       Skips silently when the sibling svchost-watch checkout is absent
       (e.g. source builds without it) — the app then offers to download the
       engine from the matching GitHub release instead. -->
  <Target Name="PublishCaptureTool" AfterTargets="Publish"
          Condition="Exists('..\svchost-watch\SvchostAnalyzer\SvchostAnalyzer.csproj')">
    <Message Importance="high" Text="Publishing SvchostAnalyzer capture engine -> $(PublishDir)tools" />
    <Exec Command="dotnet publish ..\svchost-watch\SvchostAnalyzer\SvchostAnalyzer.csproj -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(PublishDir)tools&quot;" />
  </Target>

</Project>

