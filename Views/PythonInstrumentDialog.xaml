<Window x:Class="AutoCommand.Views.PythonInstrumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrument python environments"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Instrument python environments" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                       Text="Opt-in per environment: writes the AutoCommand audit hook (PyTraceHook_ac.py + a .pth importer) into the environment's site-packages. Instrumented pythons report the Python call stack when they spawn processes, and log TLS session keys so the tab can show plaintext of what they send. Nothing else changes — no interpreter modification, no reads inside the venv."
                       ToolTip="Reach limits: -I/-E defeats PYTHONPATH-style injection but a .pth in real site-packages survives. -S, frozen and embedded interpreters never load site at all and cannot be instrumented."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="RefreshBtn" Content="🔄 Rediscover" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" Click="RefreshBtn_Click" Margin="8,0,0,0"/>
            <Button x:Name="AddVenvBtn" Content="📁 Add venv folder…" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" Click="AddVenvBtn_Click" Margin="8,0,0,0"
                    ToolTip="Pick a virtualenv/venv root folder (the one containing Lib\site-packages)"/>
            <TextBlock Text="Discovered environments:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>

        <ListBox Grid.Row="2" x:Name="EnvList" SelectionMode="Extended"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"/>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="InstallBtn" Content="✅ Instrument selected" Style="{StaticResource PrimaryButton}"
                    Click="InstallBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="UninstallBtn" Content="🧹 Remove selected" Style="{StaticResource PrimaryButton}"
                    Click="UninstallBtn_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
