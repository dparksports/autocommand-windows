<UserControl x:Class="AutoCommand.Views.SvchostMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Process Monitor" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Native Sysmon Event ID 3 tracing + Raw Socket Packet Sniffer" 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SetupSysmonBtn" Content="🛠 Setup Sysmon" Style="{StaticResource PrimaryButton}" Click="SetupSysmonBtn_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="ToggleMonitorBtn" Content="Start Monitor" Style="{StaticResource PrimaryButton}" Click="ToggleMonitorBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="SaveCsvBtn" Content="Force Save CSV" Style="{StaticResource PrimaryButton}" Click="SaveCsvBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorStatusText" Text="Monitor is stopped." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <!-- DNS cache counter chip -->
                <Border Grid.Column="1" Background="#1A4A8A" CornerRadius="10" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DnsCacheChip" Text="DNS cache: 0 entries"
                               Foreground="#7EB8F7" FontSize="11" FontFamily="Consolas"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="HideCloudCheck" Content="Hide Known/Cloud IPs" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <!-- PID inquiry: pick any PID shown below (or type one) and
                         trace how it was spawned — same engine as the row
                         context-menu's "Trace" item. -->
                    <TextBlock Text="🔎 Inquire PID:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                               ToolTip="Trace how any PID shown in the monitor was spawned: verified parent chain, spawn mechanism (shell / task / service / autostart), Sysmon create-events and typed shell history."/>
                    <ComboBox x:Name="PidCombo" Width="140" IsEditable="True" FontFamily="Consolas"
                              DropDownOpened="PidCombo_DropDownOpened" KeyDown="PidCombo_KeyDown"
                              ToolTip="Drop down to pick a PID from the list, or type any PID. Enter traces it."/>
                    <Button Content="Trace" Click="TracePidBtn_Click" Margin="8,0,0,0" Padding="12,2" Style="{StaticResource PrimaryButton}"
                            ToolTip="Open the PID inquiry window (read-only)"/>
                    <TextBlock Text="Add Process:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,8,0"/>
                    <TextBox x:Name="NewProcessBox" Width="150" Padding="4" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <Button Content="Add" Click="AddProcessBtn_Click" Margin="8,0,0,0" Padding="12,2" Style="{StaticResource PrimaryButton}"/>
                    <TextBlock Text="Ignore Process:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,8,0"
                               ToolTip="Connections from ignored processes never appear in the list"/>
                    <TextBox x:Name="IgnoreProcessBox" Width="130" Padding="4" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Process name to hide from the list, e.g. chrome or chrome.exe" KeyDown="IgnoreProcessBox_KeyDown"/>
                    <Button x:Name="IgnoreProcessBtn" Content="Ignore" Click="IgnoreProcessBtn_Click" Margin="8,0,0,0" Padding="12,2" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="IgnoredListBtn" Content="Ignored: 0" Click="IgnoredListBtn_Click" Margin="8,0,0,0" Padding="10,2" FontSize="11"
                            Background="#3A1520" Foreground="#F2A0B4" BorderThickness="0" Cursor="Hand"
                            ToolTip="View and manage ignored processes">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BlockedListBtn" Content="Blocked: 0" Click="BlockedListBtn_Click" Margin="8,0,0,0" Padding="10,2" FontSize="11"
                            Background="#3A1520" Foreground="#F2A0B4" BorderThickness="0" Cursor="Hand"
                            ToolTip="View and remove firewall blocks created from this monitor">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>
                    <Popup x:Name="BlockedListPopup" PlacementTarget="{Binding ElementName=BlockedListBtn}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="340" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Firewall blocks created from this monitor" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ListBox x:Name="BlockedListBox" MaxHeight="200" MinHeight="34" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"/>
                                <Button Content="Unblock Selected" Click="UnblockBtn_Click" Margin="0,8,0,0" Padding="12,2" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="🛠 Manage all (grouped, classified, bulk actions)…" Click="ManageBlockedBtn_Click" Margin="0,6,0,0" Padding="4,2" HorizontalAlignment="Left"
                                        Background="Transparent" Foreground="#7EB8F7" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="IgnoredListPopup" PlacementTarget="{Binding ElementName=IgnoredListBtn}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="260" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Ignored processes" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ListBox x:Name="IgnoredListBox" MaxHeight="200" MinHeight="34" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"/>
                                <Button Content="Remove Selected" Click="RemoveIgnoredBtn_Click" Margin="0,8,0,0" Padding="12,2" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connections Grid -->
        <DataGrid Grid.Row="2" x:Name="SvchostGrid" SelectionMode="Single"
                  PreviewMouseRightButtonDown="SvchostGrid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <!-- Rows with no traffic for 5+ minutes fade into the background so
                     active conversations stand out. -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                            <Setter Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="RowMenu_Opened">
                    <MenuItem x:Name="TracePidMenuItem" Header="🔎 Trace: how was this PID spawned?" Click="TracePidMenuItem_Click"/>
                    <Separator/>
                    <MenuItem x:Name="IgnoreRowMenuItem" Header="🚫 Ignore this process" Click="IgnoreRowMenuItem_Click"/>
                    <Separator/>
                    <MenuItem x:Name="BlockIpMenuItem" Header="⛔ Block Remote IP in Firewall" Click="BlockRemoteIP_Click"/>
                    <MenuItem x:Name="BlockProcessMenuItem" Header="⛔ Block Process in Firewall" Click="BlockProcess_Click"/>
                    <MenuItem x:Name="KillProcessMenuItem" Header="💀 Kill process" Click="KillProcess_Click"/>
                    <MenuItem x:Name="TaskDetailsMenuItem" Header="📋 Scheduled task details" Click="TaskDetails_Click"/>
                    <MenuItem x:Name="DisableTaskMenuItem" Header="⏸ Disable this scheduled task" Click="DisableTask_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Tooltip shows the full Sysmon image path, plus the scheduled
                     task behind it for taskhostw rows (attribution survives
                     process exit — no more bare PIDs). -->
                <DataGridTemplateColumn Header="Process" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProcessDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding ProcessToolTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Header-click sorting uses the DateTime (LastSeen), not the
                     relative-time display string, which has no meaningful order. -->
                <DataGridTextColumn Header="Last Update" Binding="{Binding LastSeenDisplay}"
                                    SortMemberPath="LastSeen" Width="100"/>
                <DataGridTextColumn Header="Tx Pkts"    Binding="{Binding TxPackets}"      Width="80"/>
                <DataGridTextColumn Header="Tx Bytes"   Binding="{Binding TxBytesDisplay}" Width="90"/>
                <DataGridTextColumn Header="Remote IP"   Binding="{Binding RemoteIp}"        Width="120"/>
                <!-- Host column: dims + italicises cells that are still resolving -->
                <DataGridTemplateColumn Header="Host" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding HostnameDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontStyle"  Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rx Pkts"    Binding="{Binding RxPackets}"      Width="80"/>
                <DataGridTextColumn Header="Rx Bytes"   Binding="{Binding RxBytesDisplay}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
