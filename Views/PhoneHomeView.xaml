<UserControl x:Class="AutoCommand.Views.PhoneHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AutoCommand.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <!-- verdict chip: green = inside the authored normal band,
             amber = above it, gray = no authored baseline -->
        <Style x:Key="VerdictChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#3398A2B3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKind}" Value="normal">
                    <Setter Property="Background" Value="#3334D399"/>
                    <Setter Property="BorderBrush" Value="#34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="elevated">
                    <Setter Property="Background" Value="#33FBBF24"/>
                    <Setter Property="BorderBrush" Value="#FBBF24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="📶 Phone Home" Style="{DynamicResource PageHeader}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,4" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="What Windows' own talkers are doing — how often each service phones out, to whom, and whether that's normal. Quiet the ones you don't want, with receipts."/>
            <TextBlock x:Name="StatusText" Text="Reading the archive…" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource VerdictChip}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding VerdictText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#14FFFFFF" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ChipProcess}"/>
                                        </Border>
                                        <Border x:Name="ImpactChip" Background="#14FFFFFF" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="high">
                                                            <Setter Property="Background" Value="#33F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="medium">
                                                            <Setter Property="Background" Value="#33FBBF24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="normal">
                                                            <Setter Property="Background" Value="#3334D399"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding ChipImpact}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding Story}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding MetricsLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding BytesLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding DestinationsLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding BeaconLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding IdentityLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ReceiptsLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#34D399" Margin="0,0,0,3"
                                           Visibility="{Binding ReceiptsLine, Converter={StaticResource NonEmptyToVis}}"/>
                                <TextBlock Text="{Binding Footnote}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔇 Quiet it — keep receipts" Margin="0,0,8,0" Padding="10,4"
                                            Visibility="{Binding CanQuiet, Converter={StaticResource BoolToVis}}"
                                            Click="QuietBtn_Click"/>
                                    <Button Content="↩ Undo quiet" Margin="0,0,8,0" Padding="10,4"
                                            Visibility="{Binding IsQuieted, Converter={StaticResource BoolToVis}}"
                                            Click="UndoQuietBtn_Click"/>
                                    <Button Content="⛔ Block its top destinations" Padding="10,4"
                                            Click="BlockBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"
                       Text="Frequencies come from the local Sysmon archive (last 24 h) and the live connection table — nothing leaves the machine. 'Quiet it' pins Microsoft's telemetry endpoints in the hosts file (127.0.0.1 sinkhole, so denied attempts stay visible on this card and in Black Hole); undo removes the pins. Destination blocks are ordinary AutoCommand firewall blocks — reversible from the Blocks tab."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
