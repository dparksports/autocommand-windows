<UserControl x:Class="AutoCommand.Views.TransmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Transmissions" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="What this machine actually sends to the cloud — decrypted via SSL session keys, decoded to HTTP messages, full bodies on disk"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ToggleWatchBtn" Content="Start Watch" Style="{StaticResource PrimaryButton}" Click="ToggleWatchBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearBtn" Content="🗑 Clear" Style="{StaticResource PrimaryButton}" Click="ClearBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportBtn" Content="💾 Export JSONL" Style="{StaticResource PrimaryButton}" Click="ExportBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="LaunchBtn" Content="🚀 Launch under watch…" Style="{StaticResource PrimaryButton}" Click="LaunchBtn_Click" Margin="0,0,8,0"
                        ToolTip="Start a program with SSLKEYLOGFILE set in its environment only — the precise instrument for one app."/>
                <CheckBox x:Name="SystemKeylogCheck" Content="🔑 System-wide key capture" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}" Checked="SystemKeylogCheck_Changed" Unchecked="SystemKeylogCheck_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Status + filter -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Watcher is stopped." Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="BigOnlyCheck" Grid.Column="1" Content="uploads &gt; 10KB only" VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{DynamicResource TextPrimaryBrush}" Checked="ApplyFilter" Unchecked="ApplyFilter"/>
                <TextBlock Grid.Column="2" Text="Filter (regex):" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                           ToolTip="Regex over process, SNI/host, destination IP, provider and status — the 'what was sent where' search."/>
                <TextBox x:Name="FilterBox" Grid.Column="3" Width="240" Padding="4" FontFamily="Consolas"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" TextChanged="FilterBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Flow grid -->
        <DataGrid Grid.Row="2" x:Name="FlowGrid" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="FlowGrid_SelectionChanged" PreviewMouseRightButtonDown="FlowGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CopyRowMenuItem" Header="📋 Copy row as JSON" Click="CopyRowMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" SortMemberPath="TsUtc" Width="95"/>
                <DataGridTemplateColumn Header="10KB" Width="48" SortMemberPath="BigUpload">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                    Background="#3A2E14" Visibility="{Binding BigUploadVisibility}">
                                <TextBlock Text="↑10K" FontSize="10" Foreground="#E5A631"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55"/>
                <DataGridTemplateColumn Header="Process" Width="130" SortMemberPath="Image">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProcessDisplay}" ToolTip="{Binding Image}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Host (SNI)" Width="170" SortMemberPath="Sni">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding HostDisplay}" ToolTip="{Binding HostDisplay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Destination" Binding="{Binding ServerEndpoint}" Width="125"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderAndCountry}" Width="150" SortMemberPath="Provider"/>
                <DataGridTextColumn Header="Up" Binding="{Binding UpDisplay}" SortMemberPath="ClientBytes" Width="65"/>
                <DataGridTextColumn Header="Down" Binding="{Binding DownDisplay}" SortMemberPath="ServerBytes" Width="65"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/>
                <DataGridTextColumn Header="Messages" Binding="{Binding MessageCount}" Width="65"/>
                <DataGridTextColumn Header="Content" Binding="{Binding ContentKinds}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"/>

        <!-- Detail pane -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Flow summary -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailRecordPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Content viewer -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="SaveBodyBtn" DockPanel.Dock="Right" Content="💾 Save body" Style="{StaticResource PrimaryButton}"
                                Click="SaveBodyBtn_Click" Margin="8,0,0,0"/>
                        <ComboBox x:Name="ViewModeCombo" DockPanel.Dock="Right" Width="80" SelectedIndex="0" SelectionChanged="ViewModeCombo_SelectionChanged">
                            <ComboBoxItem Content="pretty"/>
                            <ComboBoxItem Content="text"/>
                            <ComboBoxItem Content="hex"/>
                            <ComboBoxItem Content="headers"/>
                        </ComboBox>
                        <ComboBox x:Name="MessageCombo" Margin="0,0,8,0"
                                  SelectionChanged="MessageCombo_SelectionChanged"
                                  ToolTip="Every decoded HTTP message in this conversation — → is what this machine sent, ← is what came back."/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="ContentText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Text="Select a transmission to see exactly what was sent."/>
                    <TextBlock Grid.Row="2" x:Name="ContentFooter" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
