<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hidden Telemetry Engine -->
        <wv2:WebView2 x:Name="HiddenTelemetryWebView" Width="1" Height="1" Visibility="Hidden" IsHitTestVisible="False" />

        <!-- Main Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Left"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Process Monitor" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SvchostMonitorView x:Name="SvchostTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Traffic Patterns" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TrafficPatternsView x:Name="TrafficPatternsTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🛡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Firewall" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🔬" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Svchost Trace" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SvchostTraceView x:Name="SvchostTraceTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🧵" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Taskhostw Spawns" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TaskHostSpawnView x:Name="TaskhostwSpawnsTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🐍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Python Spawns" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:PythonSpawnView x:Name="PythonSpawnsTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🧭" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Sysmon Audit" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SysmonStatusView x:Name="SysmonTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🦠" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Windows Defender" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DefenderView x:Name="DefenderTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🔐" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Data &amp; Privacy" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:PrivacyView x:Name="PrivacyTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="⚙" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Settings" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="ThreatAlertText" Text=""
                               Foreground="#E5A631" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ReviewAlertBtn" Content="Review"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ReviewAlertBtn_Click"/>
                    <Button x:Name="RestoreInternetBtn" Content="🚑 Restore Internet"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            ToolTip="Blocked something and lost connectivity? Disables ALL AutoCommand-created firewall block rules at once. Fully reversible — nothing is deleted."
                            Click="RestoreInternetBtn_Click"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="AutoCommand"
                           Foreground="#5A5A62" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
