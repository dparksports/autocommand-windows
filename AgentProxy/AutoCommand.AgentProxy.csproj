<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MCP client's spawn target: a tiny asInvoker console exe (no WPF,
       no admin, no UAC) that forwards stdio JSON-RPC to the running elevated
       AutoCommand instance over loopback. Referenced by the app project so it
       builds (and publishes) alongside AutoCommand; users never run it by
       hand — the AI client's MCP config does, via the path the app's
       Settings > AI access card installs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AutoCommand.AgentProxy</AssemblyName>
    <AssemblyTitle>AutoCommand Agent Proxy</AssemblyTitle>
    <Product>AutoCommand</Product>
    <Version>2026.10.14.1</Version>
  </PropertyGroup>

</Project>
